% ΔΙΔΑΚΤΙΚΑ ΚΟΥΤΙΑ (tcolorbox)
% Ένα semantic περιβάλλον σημαίνει ότι κάθε αντίστοιχη χρήση στο βιβλίο
% έχει ίδια εμφάνιση. Π.χ. \begin{ThinkBox}...\end{ThinkBox}.
% BookSoft = ανοιχτό φόντο, BookPrimary = βαθύ μπλε, BookAlert = προσοχή.
% Η παλέτα αλλάζει ξεχωριστά για οθόνη και δοκιμαστική εκτύπωση.
% ---------------------------------------------------------------------------
\tcbset{BookPanel/.style={enhanced,breakable,sharp corners,boxrule=.35pt,top=2.4mm,bottom=2.4mm,left=3.5mm,right=3.5mm,before skip=7pt,after skip=8pt}}
\newtcolorbox{LearningGoals}{BookPanel,colback=BookSoft,colframe=BookSecondary,borderline west={2.1pt}{0pt}{BookSecondary},title={\LabelGoals},fonttitle=\bfseries\sffamily\small,coltitle=BookPrimary,attach title to upper={\par\medskip},before upper={\small}}
% v0.30: Κοινό θεμέλιο BookCallout για ΟΛΑ τα διδακτικά callouts.
% Οποιαδήποτε αλλαγή στην κοινή γεωμετρία γίνεται μόνο μία φορά εδώ.
% Το περιβάλλον BookCallout ΔΕΝ είναι νέα εντολή συγγραφής, αλλά tcolorbox style.
% Ο συγγραφέας χρησιμοποιεί απαράλλακτα AttentionBox / ThinkBox / HistoryBox.
% left=17.5mm: δεσμεύει μια στενή αριστερή ζώνη για το εικονίδιο.
% frame.west: το κατακόρυφο κέντρο όλου του κουτιού. Σε breakable κουτί
% σχεδιάζουμε το εικονίδιο μόνο στο πρώτο τμήμα, στο δικό του μέσο.
\tcbset{BookCallout/.style={%
  enhanced,breakable,sharp corners,boxrule=0pt,frame hidden,
  top=2.6mm,bottom=2.6mm,left=17.5mm,right=3.6mm,
  before skip=7pt,after skip=8pt
}}
\newcommand{\BookCalloutCenteredIcon}[1]{%
  \node[anchor=center,inner sep=0pt] at
  ([xshift=\BookCalloutIconOffset]frame.west) {#1};%
}
% v1.0.2: Τα τρία ενεργά εικονίδια, οι τίτλοι και τα περιγράμματα των κουτιών
% μοιράζονται τον BookCalloutAccent (SCREEN μπλε / PRINT δεύτερο spot, 100%).
% Τα εικονίδια είναι vector TikZ και βάφονται αποκλειστικά με
% σημασιολογικά χρώματα της παλέτας (SCREEN ή PRINT), όχι με τρίτο μελάνι.
% v0.34: λίγο μικρότερη λάμπα, ενισχυμένες γραμμές και ορατό νήμα.
\newcommand{\BookCalloutBulb}{%
  \begin{tikzpicture}[x=1mm,y=1mm,scale={\BookCalloutIconScale*\BookBulbScale},
    line cap=round,line join=round]
    \draw[draw=BookCalloutAccent,line width=\BookBulbOutlineWidth] (-2.5,1.1)
      .. controls (-2.6,2.7) and (-1.5,3.7) .. (0,3.7)
      .. controls (1.5,3.7) and (2.6,2.7) .. (2.5,1.1)
      .. controls (2.45,-.3) and (1.15,-.65) .. (1,-1.8)
      -- (-1,-1.8)
      .. controls (-1.15,-.65) and (-2.45,-.3) .. cycle;
    \draw[draw=BookCalloutAccent,line width=\BookBulbOutlineWidth] (-1.05,-2.55)--(1.05,-2.55);
    \draw[draw=BookCalloutAccent,line width=\BookBulbOutlineWidth] (-.7,-3.25)--(.7,-3.25);
    % Δύο στηρίγματα και τρεις κορυφές του νήματος βολφραμίου.
    \draw[draw=BookCalloutAccent,line width=\BookBulbFilamentWidth]
      (-.5,-1.3)--(-.85,.35)--(-1.2,1.0)
      --(-.8,1.65)--(-.4,1.0)--(0,1.65)--(.4,1.0)--(.8,1.65)--(1.2,1.0)
      --(.85,.35)--(.5,-1.3);
    \draw[draw=BookCalloutAccent,line width=\BookBulbRayWidth] (0,4.65)--(0,5.35);
    \draw[draw=BookCalloutAccent,line width=\BookBulbRayWidth] (-3.3,3.55)--(-3.9,4.1);
    \draw[draw=BookCalloutAccent,line width=\BookBulbRayWidth] (3.3,3.55)--(3.9,4.1);
    \draw[draw=BookCalloutAccent,line width=\BookBulbRayWidth] (-3.65,.6)--(-4.35,.6);
    \draw[draw=BookCalloutAccent,line width=\BookBulbRayWidth] (3.65,.6)--(4.35,.6);
  \end{tikzpicture}%
}
