% ---------------------------------------------------------------------------
% ΙΣΤΟΡΙΚΕΣ ΙΣΤΟΡΙΕΣ: HistoryBox
% Χρήση: \begin{HistoryBox}[Προαιρετικός τίτλος] ... \end{HistoryBox}
% Κληρονομεί το BookCallout, ακριβώς όπως ThinkBox και AttentionBox.
% SCREEN: ουδέτερο πολύ αχνό ΓΚΡΙ, όχι κίτρινο.
% PRINT: 10% μαύρο φόντο + 55% μαύρο στην αριστερή γραμμή.
% Μοναδικό περιεχόμενο: ένα προαιρετικό θέμα, έπειτα οποιοδήποτε κείμενο,
% μαθηματικό τύπο, εικόνα ή υποσημείωση. Το breakable επιτρέπει αλλαγή σελίδας.
% ---------------------------------------------------------------------------
% v0.30: Το HistoryBox ΚΛΗΡΟΝΟΜΕΙ από BookCallout.
% Πλέον έχει ακριβώς το ίδιο πλάτος πλευρικής ζώνης (17.5mm),
% κατακόρυφο κεντράρισμα στο frame.west και τις ίδιες αποστάσεις.
% Μόνο το γκρι χρώμα, ο τίτλος και το σχέδιο διαφέρουν.
% Το ίδιο όνομα HistoryBox και το ίδιο προαιρετικό όρισμα εξακολουθούν
% να ισχύουν για κάθε παλιό κεφάλαιο. Σε breakable κουτί το εικονίδιο
% τοποθετείται στο κατακόρυφο μέσο του πρώτου τμήματος.
\newtcolorbox{HistoryBox}[1][]{%
  BookCallout,
  colback=BookHistorySoft,
  borderline west={1.35pt}{0pt}{BookHistoryBorder},
  before upper={\noindent{\BookMediumLabelFont\fontsize{9.2}{11.5}\selectfont
    \color{BookHistory}\LabelHistory\ifstrempty{#1}{}{ — #1}}\par\smallskip\small},
  overlay unbroken={\BookCalloutCenteredIcon{\BookCalloutOpenBook}},
  overlay first={\BookCalloutCenteredIcon{\BookCalloutOpenBook}}
}

% ---------------------------------------------------------------------------
% ΡΗΣΕΙΣ / ΑΠΟΦΘΕΓΜΑΤΑ: BookQuote
% Χρήση: \BookQuote{Σύντομη ρήση}{Συγγραφέας}[Προαιρετική πηγή]
%   - ΔΕΝ είναι κουτί: μηδενική σκίαση/περίγραμμα, μόνο λευκός χώρος.
%   - Η ρήση χρησιμοποιεί την υπάρχουσα Noto Serif (BookHeadingFont) πλάγια.
%   - Το εισαγωγικό είναι BookSecondary (μπλε SCREEN, 55% spot PRINT).
%   - Το όνομα/πηγή μπαίνουν δεξιά, στην ίδια μονάδα με τη ρήση.
%   - \Needspace & minipage κρατούν ΟΛΟ το σύντομο απόσπασμα μαζί.
%     Για παραθέματα πολλών παραγράφων προτείνεται ξεχωριστή δομή.
% Δεν εισάγουμε νέες γραμματοσειρές ή νέα εκτυπωτικά μελάνια.
% ---------------------------------------------------------------------------
\NewDocumentCommand{\BookQuote}{m m o}{%
  \par\Needspace{5\baselineskip}\addvspace{10pt}%
  \noindent\hspace*{3mm}%
  \begin{minipage}{\dimexpr\linewidth-7mm\relax}%
    \raggedright%
    {\BookHeadingFont\color{BookSecondary}\fontsize{22}{23}\selectfont “\kern2mm}%
    {\BookHeadingFont\itshape\color{BookInk}\fontsize{11.4}{16.4}\selectfont #1}\par\vspace{4pt}%
    {\raggedleft\sffamily\fontsize{8.5}{11}\selectfont\color{BookInk}— #2\par}%
    \IfNoValueF{#3}{\vspace{1pt}{\raggedleft\sffamily\fontsize{7.3}{10}\selectfont
       \color{BookHistory}#3\par}}%
  \end{minipage}%
  \par\addvspace{10pt}%
}
