        (-3.45,1.3+\y) .. controls (-2.55,1.25+\y) and (-1.55,.9+\y) .. (-.85,.5+\y);
      \draw[draw=BookHistory,line width=\BookOpenBookDetailWidth]
        (3.45,1.3+\y) .. controls (2.55,1.25+\y) and (1.55,.9+\y) .. (.85,.5+\y);
    }%
