% The third argument is a list of 4--6 short \item learning outcomes.
% Χωρίς φωτογραφία, εναλλακτική έναρξη κεφαλαίου.
% [σύντομος τίτλος κεφαλίδας] προαιρετικά· μετά τίτλος, υπότιτλος και στόχοι.
% ---------------------------------------------------------------------------
% ΑΥΤΟΜΑΤΟΣ ΠΙΝΑΚΑΣ ΠΕΡΙΕΧΟΜΕΝΩΝ ΓΙΑ ΦΥΛΛΑ/ΚΡΙΤΗΡΙΑ (v0.18)
% ---------------------------------------------------------------------------
% ΚΑΝΟΝΑΣ ΙΕΡΑΡΧΙΑΣ:
%   chapter    = Κεφάλαιο/Ενότητα, π.χ. «1 Κίνηση σε μία διάσταση».
%   section    = Κανονική αριθμημένη ενότητα θεωρίας.
%   bookcollection = Μη αριθμημένη ομάδα φύλλων/κριτηρίων (επίπεδο 1).
%   bookitem   = Κάθε φύλλο ή κριτήριο με τίτλο και σελίδα (επίπεδο 2).
%
% Αυτό σημαίνει ότι τα συμπληρωματικά υλικά ΕΝΤΑΣΣΟΝΤΑΙ στο κεφάλαιο
% μέσα στο οποίο έχουν τοποθετηθεί στο book-content.tex.
% Δεν αποκτούν αρίθμηση 1.3 ή 1.4: οι τίτλοι τους είναι μη αριθμημένοι.
%
% ΧΡΩΜΑΤΑ ΣΤΑ ΠΕΡΙΕΧΟΜΕΝΑ (v0.19):
% - ΟΛΕΣ οι καταχωρίσεις παραμένουν στο κανονικό μαύρο του TOC.
% - Ιεραρχία δηλώνεται ΜΟΝΟ με μέγεθος, ένταση και εσοχή:
%     Κεφάλαιο > αριθμημένη section > ομαδικός τίτλος > επιμέρους τίτλος.
% - Δεν χρησιμοποιούμε δεύτερο εκτυπωτικό μελάνι στα περιεχόμενα.
% - Τα χρώματα των τίτλων ΜΕΣΑ στις σελίδες ΔΕΝ αλλάζουν.
%
% Το BookTOCActiveCollection κρατά το είδος της τελευταίας ομάδας, ώστε
% να μην επαναλαμβάνεται άσκοπα ο ομαδικός τίτλος για διαδοχικά φύλλα.
% Μηδενίζεται όταν αρχίζει νέο κεφάλαιο. Αν μεταξύ δύο ομάδων αλλάξει
% το είδος υλικού, τυπώνεται ξανά η αντίστοιχη επικεφαλίδα.
% Με \phantomsection ο σύνδεσμος δείχνει στην αρχή της ομάδας.
% Με δύο/τρεις διαδοχικές μεταγλωττίσεις ενημερώνονται οι σωστές σελίδες.
\input{styles/book-toc.tex}
\newcommand{\BookTOCActiveCollection}{}
\newcommand{\BookTOCOpenCollection}[2]{%
  \ifdefstring{\BookTOCActiveCollection}{#1}{}{%
    \phantomsection%
    \addcontentsline{toc}{bookcollection}{#2}%
    \gdef\BookTOCActiveCollection{#1}%
  }%
}

% ---------------------------------------------------------------------------
% v0.29 — ΣΤΟΧΟΙ ΚΕΦΑΛΑΙΟΥ: ΜΟΝΟ ΛΕΠΤΗ ΑΡΙΣΤΕΡΗ ΓΡΑΜΜΗ (ΕΠΙΛΟΓΗ Β).
% Δεν προσθέτουμε σκιασμένο φόντο/πλήρες περίγραμμα, ούτε ρητό.
% Ίδιο BookOpeningGoalsPanel ΚΑΙ για τις δύο διαδρομές έναρξης κεφαλαίου,
% χωρίς φωτογραφία (BookChapter) ή με φωτογραφία (BookChapterPhoto).
% Χρωματικός ρόλος BookSecondary και στις δύο εκδόσεις.
% Ο συγγραφέας δίνει μόνο τις 4–6 υπάρχουσες γραμμές \item.
% Το προαιρετικό #1 είναι η απόσταση μεταξύ των στόχων (4pt ή 6pt).
% Δεν συγχέεται με το ξεχωριστό LearningGoals των φύλλων εργασίας.
% ---------------------------------------------------------------------------
\newtcolorbox{BookOpeningGoalsPanel}{%
  enhanced,sharp corners,boxrule=0pt,frame hidden,
  colback=white,borderline west={\BookOpeningGoalsRuleWidth}{0pt}{\BookOpeningGoalsAccent},
  top=1.1mm,bottom=1.1mm,left=\BookOpeningGoalsLeftPadding,right=1mm,
  before skip=0pt,after skip=0pt
}
\newcommand{\BookOpeningGoals}[2][4pt]{%
  \begin{BookOpeningGoalsPanel}
  {\BookHeadingFont\fontsize{14}{18}\selectfont\color{\BookOpeningGoalsAccent}\LabelChapterGoals}\par\vspace{2mm}
  \begin{itemize}[label={\textcolor{\BookOpeningGoalsAccent}{\textbullet}},leftmargin=5.4mm,itemsep=#1,topsep=0pt,partopsep=0pt,parsep=0pt]
    \color{BookInk}\fontsize{10.2}{14.5}\selectfont
    #2
  \end{itemize}
  \end{BookOpeningGoalsPanel}%
}

% Οι επικεφαλίδες μετρώνται πριν σχεδιαστεί η χρωματιστή επιφάνεια.
% Έτσι οι μεγάλοι πλήρεις τίτλοι δεν αφήνουν λευκό κείμενο έξω από το χρώμα.
\newsavebox{\BookChapterHeadingBox}
\newsavebox{\BookChapterGoalsBox}
\newsavebox{\BookChapterCreditBox}
\newsavebox{\BookChapterPageBox}
\newlength{\BookChapterBandHeight}
\newlength{\BookChapterGap}
\newlength{\BookChapterImageMaxHeight}
\newcommand{\BookChapterBand}[2]{%
  \setlength{\BookChapterBandHeight}{\dimexpr\BookMarginTop+#1+\ht\BookChapterHeadingBox+\dp\BookChapterHeadingBox+9mm\relax}%
  \ifdim\BookChapterBandHeight<#2\relax\setlength{\BookChapterBandHeight}{#2}\fi
  \par\nointerlineskip
  \vbox to0pt{\hbox{\begin{tikzpicture}[remember picture,overlay]
      \fill[BookPrimary] (current page.north west) rectangle
        ([yshift=-\BookChapterBandHeight]current page.north east);
    \end{tikzpicture}}\vss}%
  \nointerlineskip
}
\NewDocumentCommand{\BookChapter}{O{} m m +m}{%
  \cleardoublepage
  \refstepcounter{chapter}\setcounter{section}{0}\setcounter{subsection}{0}\gdef\BookTOCActiveCollection{}
  \ifstrempty{#1}{\BookRememberRunningChapter{#2}}{\BookRememberRunningChapter{#1}}%
  \addcontentsline{toc}{chapter}{\protect\numberline{\thechapter}#2}%
  \markboth{#2}{#2}\thispagestyle{empty}%
  \setbox\BookChapterHeadingBox=\vbox{\hsize=\linewidth\parindent=0pt\parskip=0pt
    {\color{white}\sffamily\bfseries\fontsize{9.5}{12}\selectfont ΕΝΟΤΗΤΑ \thechapter\par}%
    \vskip14mm
    {\BookHeadingFont\bfseries\color{white}\fontsize{24}{29}\selectfont\RaggedRight #2\par}%
    \vskip4mm
    {\color{white}\fontsize{10}{14}\selectfont\RaggedRight #3\par}%
  }%
  \setbox\BookChapterGoalsBox=\vbox{\hsize=\linewidth\BookOpeningGoals[6pt]{#4}}%
  \BookChapterBand{15mm}{84mm}%
  \setlength{\BookChapterGap}{\dimexpr\textheight-15mm-\ht\BookChapterHeadingBox-\dp\BookChapterHeadingBox-\ht\BookChapterGoalsBox-\dp\BookChapterGoalsBox-15mm\relax}%
  \ifdim\BookChapterGap>42mm\setlength{\BookChapterGap}{42mm}\fi
  \ifdim\BookChapterGap<9mm
    \PackageError{universalbook}{Chapter title/goals exceed the opening page}{Shorten the full title or the learning goals.}%
    \setlength{\BookChapterGap}{9mm}%
  \fi
  \setbox\BookChapterPageBox=\vbox{\hsize=\linewidth\offinterlineskip
    \kern15mm\copy\BookChapterHeadingBox
    \kern\BookChapterGap\copy\BookChapterGoalsBox}%
  \noindent\usebox{\BookChapterPageBox}\par
  \vfill\clearpage
}

% [short running title] optional; then fulltitle, subtitle, asset, credit, goals.
% Η διαθέσιμη φωτογραφία προσαρμόζεται όταν ο πλήρης τίτλος έχει πολλές γραμμές.
\NewDocumentCommand{\BookChapterPhoto}{O{} m m m m +m}{%
  \cleardoublepage
  \refstepcounter{chapter}\setcounter{section}{0}\setcounter{subsection}{0}\gdef\BookTOCActiveCollection{}
  \ifstrempty{#1}{\BookRememberRunningChapter{#2}}{\BookRememberRunningChapter{#1}}%
  \addcontentsline{toc}{chapter}{\protect\numberline{\thechapter}#2}%
  \markboth{#2}{#2}\thispagestyle{empty}%
  \setbox\BookChapterHeadingBox=\vbox{\hsize=\linewidth\parindent=0pt\parskip=0pt
    {\color{white}\sffamily\bfseries\fontsize{9.5}{12}\selectfont ΕΝΟΤΗΤΑ \thechapter\par}%
    \vskip13mm
    {\BookHeadingFont\color{white}\fontsize{23}{28}\selectfont\RaggedRight #2\par}%
    \vskip4mm
    {\color{white}\fontsize{9.7}{13}\selectfont\RaggedRight #3\par}%
  }%
  \setbox\BookChapterGoalsBox=\vbox{\hsize=\linewidth\BookOpeningGoals{#6}}%
  \setbox\BookChapterCreditBox=\vbox{\hsize=\linewidth\parskip=0pt
    {\raggedleft\fontsize{7.4}{10}\selectfont\color{BookSecondary}\itshape #5\par}}%
  \setlength{\BookChapterImageMaxHeight}{\dimexpr\textheight-13mm-\ht\BookChapterHeadingBox-\dp\BookChapterHeadingBox-18mm-\ht\BookChapterCreditBox-\dp\BookChapterCreditBox-8mm-\ht\BookChapterGoalsBox-\dp\BookChapterGoalsBox-9mm\relax}%
  \ifdim\BookChapterImageMaxHeight>\BookChapterPhotoHeight\relax
    \setlength{\BookChapterImageMaxHeight}{\BookChapterPhotoHeight}%
  \fi
  \ifdim\BookChapterImageMaxHeight<25mm
    \PackageError{universalbook}{Chapter title/goals leave no room for artwork}{Shorten the full title/goals or use BookChapter without artwork.}%
    \setlength{\BookChapterImageMaxHeight}{25mm}%
  \fi
  \BookChapterBand{13mm}{75mm}%
  \setbox\BookChapterPageBox=\vbox{\hsize=\linewidth\offinterlineskip
    \kern13mm\copy\BookChapterHeadingBox\kern18mm
    \hbox to\linewidth{\hfil
      \BookUseAsset[width=\linewidth,height=\BookChapterImageMaxHeight,keepaspectratio]{#4}\hfil}%
    \kern1mm\copy\BookChapterCreditBox\kern8mm\copy\BookChapterGoalsBox}%
  \noindent\usebox{\BookChapterPageBox}\par\vfill\clearpage
}

