% v0.30: Συμμετρικό, minimal ανοικτό βιβλίο για HistoryBox.
% Οι πάνω/κάτω καμπύλες είναι κατοπτρικές γύρω από y=0.
% Τρεις σύντομες γραμμές ανά σελίδα (όχι μία). Δεν υπάρχει εικόνα bitmap.
% Ίδια κλίμακα/σταθερή αριστερή ζώνη όπως στα άλλα δύο callouts.
% Το χρώμα BookHistoryBorder είναι ουδέτερο γκρι SCREEN / 55% μαύρο PRINT.
\newcommand{\BookCalloutOpenBook}{%
  \begin{tikzpicture}[x=1mm,y=1mm,scale=\BookCalloutIconScale,
    line cap=round,line join=round]
    % Περίγραμμα δύο συμμετρικών ανοιγμένων σελίδων (πάνω/κάτω).
    \draw[draw=BookHistoryBorder,line width=.90pt]
      (0,3.30)
      .. controls (-1.2,3.95) and (-2.9,3.95) .. (-4.1,3.30)
      -- (-4.1,-3.30)
      .. controls (-2.9,-3.95) and (-1.2,-3.95) .. (0,-3.30)
      .. controls (1.2,-3.95) and (2.9,-3.95) .. (4.1,-3.30)
      -- (4.1,3.30)
      .. controls (2.9,3.95) and (1.2,3.95) .. cycle;
    % Σταθερή ευθεία ράχη, χωρίς άνισες καμπυλότητες.
    \draw[draw=BookHistoryBorder,line width=.78pt] (0,3.30)--(0,-3.30);
    % Τρεις εσωτερικές γραμμές ανά σελίδα, συμμετρικά.
    \foreach \y in {1.65,.40,-.85}{%
      \draw[draw=BookHistoryBorder,line width=.53pt] (-3.15,\y)--(-.85,\y);
      \draw[draw=BookHistoryBorder,line width=.53pt] (.85,\y)--(3.15,\y);
    }%
  \end{tikzpicture}%
}
