% Generic exercise: source ID is kept for stable cross-reference but hidden by default.
% Passing an empty second argument makes the statement start immediately after '1 |'.
% Named exercise subtypes (e.g., worksheet prompts) still support a visible title.
% ΠΑΡΑΔΕΙΓΜΑ ΧΡΗΣΗΣ: \begin{exercise}[PHY-A-015]{}Κείμενο...\end{exercise}
% #1 προαιρετικό μοναδικό ID, #2 προαιρετικός τίτλος (κενό στις άλυτες).
% Το ορατό αποτέλεσμα είναι «15 | Εκφώνηση...».
\NewDocumentEnvironment{exercise}{O{} m}{%
 \Needspace{4\baselineskip}\stepcounter{bookexerciseanchor}\refstepcounter{exercise}%
 \ifstrempty{#1}{}{\label{ex:#1}}%
 \par\addvspace{6pt}\noindent\leavevmode
 \mbox{{\fontsize{\BookExerciseNumberSize}{14}\selectfont\bfseries\color{BookPrimary}\theexercise}%
   \hspace{2.3mm}{\color{BookSecondary}\rule{\BookExerciseSeparatorWidth}{\BookExerciseSeparatorHeight}}}%
 \nobreak\hspace{2.6mm}%
 % Τίτλος άσκησης (π.χ. «Σωστό ή Λάθος;»): μαύρος και μόνο αυτός ημίτονος/έντονος.
 % ΚΡΙΣΙΜΟ: το πρόσθετο {...} περιορίζει το χρώμα και το bold στον τίτλο.
 % Χωρίς το group, το \color{BookPrimary} και το \bfseries κληρονομούνταν
 % σε ΟΛΟ το κείμενο της εκφώνησης του Φύλλου Εργασίας.
 % Η ίδια η εκφώνηση μένει στην κανονική Inter, 100% μαύρη.
 \ifstrempty{#2}{}{{\sffamily\bfseries\color{BookInk}#2}\enspace}%
 \color{BookInk}% Ρητή επαναφορά μαύρου και στην περίπτωση κενού τίτλου.
 \ifBookShowExerciseIDs\ifstrempty{#1}{}{\hfill{\scriptsize\color{BookSecondary}\texttt{#1}}\par\noindent}\fi
 \ignorespaces
}{\par\addvspace{3pt}}
