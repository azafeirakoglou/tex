\newcounter{exercise}[chapter]
\renewcommand{\theexercise}{\arabic{exercise}}
% Generic exercise: source ID is kept for stable cross-reference but hidden by default.
% Passing an empty second argument makes the statement start immediately after '1 |'.
% Named exercise subtypes (e.g., worksheet prompts) still support a visible title.
% ΠΑΡΑΔΕΙΓΜΑ ΧΡΗΣΗΣ: \begin{exercise}[PHY-A-015]{}Κείμενο...\end{exercise}
% #1 προαιρετικό μοναδικό ID, #2 προαιρετικός τίτλος (κενό στις άλυτες).
% Το ορατό αποτέλεσμα είναι «15 | Εκφώνηση...».
\NewDocumentEnvironment{exercise}{O{} m}{%
 \Needspace{4\baselineskip}\refstepcounter{exercise}%
 \ifstrempty{#1}{}{\label{ex:#1}}%
 \par\addvspace{6pt}\noindent\leavevmode
 \mbox{{\fontsize{\BookExerciseNumberSize}{14}\selectfont\bfseries\color{BookPrimary}\theexercise}%
   \hspace{2.3mm}{\color{BookSecondary}\rule{\BookExerciseSeparatorWidth}{\BookExerciseSeparatorHeight}}}%
 \nobreak\hspace{2.6mm}%
 % Τίτλος άσκησης (π.χ. «Σωστό ή Λάθος;»): μαύρος και μόνο αυτός ημίτονος/έντονος.
 % ΚΡΙΣΙΜΟ: το πρόσθετο {...} περιορίζει το χρώμα και το bold στον τίτλο.
 % Χωρίς το group, το \color{BookPrimary} και το \bfseries κληρονομούνταν
 % σε ΟΛΟ το κείμενο της εκφώνησης του Φύλλου Εργασίας.
 % Η ίδια η εκφώνηση μένει στην κανονική Inter, 100% μαύρη.
 \ifstrempty{#2}{}{{\sffamily\bfseries\color{BookInk}#2}\enspace}%
 \color{BookInk}% Ρητή επαναφορά μαύρου και στην περίπτωση κενού τίτλου.
 \ifBookShowExerciseIDs\ifstrempty{#1}{}{\hfill{\scriptsize\color{BookSecondary}\texttt{#1}}\par\noindent}\fi
 \ignorespaces
}{\par\addvspace{3pt}}
\newcommand{\Answer}[1]{\ifShowAnswers{\par\smallskip\fontsize{8.2}{11}\selectfont\itshape\color{BookSecondary}[Απ.: #1]\par}\fi}
\newcommand{\TopicTag}[1]{{\sffamily\bfseries\footnotesize\color{BookSecondary}#1}}
\newcounter{worksheet}[chapter]
% ΦΥΛΛΟ ΕΡΓΑΣΙΑΣ: κατασκευάζει την κεφαλίδα και αυξάνει μετρητή.
% \WorksheetOpening{Ενότητα 1}{Μετατόπιση και διάστημα}
% Αυτή η καταχώριση γίνεται αυτόματα για ΚΑΘΕ φύλλο εργασίας.
% Το πρώτο φύλλο προσθέτει και την ομάδα «Φύλλα εργασίας» (επίπεδο section).
% Κάθε φύλλο είναι subsection μέσα στο τρέχον κεφάλαιο.
% Στο TOC εμφανίζεται «Φύλλο εργασίας 1 — Θέση, μετατόπιση ...».
\newcommand{\WorksheetOpening}[2]{\clearpage\setcounter{exercise}{0}\refstepcounter{worksheet}%
 \BookTOCOpenCollection{worksheet}{Φύλλα εργασίας}%
 \phantomsection\addcontentsline{toc}{subsection}{Φύλλο εργασίας\space\theworksheet\space—\space #2}%
 \markboth{Φύλλα εργασίας}{Φύλλα εργασίας}\vspace*{2mm}\noindent\begin{tcolorbox}[enhanced,sharp corners,boxrule=0pt,colback=BookPrimary,left=4mm,right=4mm,top=3mm,bottom=3mm,overlay={\fill[BookSecondary] ([xshift=-18mm]frame.north east) rectangle (frame.south east);\node[text=white,font=\bfseries\Large] at ([xshift=-9mm]frame.east) {\theworksheet};}]\color{white}{\footnotesize\bfseries\BookShortName\enspace·\enspace #1}\par{\BookHeadingFont\bfseries\large \LabelWorksheet}\par{\small #2}\end{tcolorbox}\medskip}
\newcommand{\WorksheetSection}[1]{\Needspace{3\baselineskip}\vspace{5pt}\noindent\colorbox{BookSecondary}{\parbox{\dimexpr\linewidth-2\fboxsep\relax}{\color{white}\bfseries\small #1}}\par\smallskip}
\newcommand{\AnswerLine}{\par\vspace{4mm}\noindent\color{BookPaleRule}\rule{\linewidth}{.3pt}\color{BookInk}\par\vspace{3mm}}
\newcommand{\AnswerGrid}[1]{\par\begin{tikzpicture}\foreach \y in {0,...,#1}{\draw[BookPaleRule,line width=.3pt] (0,-\y*.60) -- (12.6,-\y*.60);}\end{tikzpicture}\par}
% Τετραγωνάκι απάντησης: το BookCheckSquareSize είναι σε εκατοστά.
% Δεν χρησιμοποιούμε το Unicode □, γιατί το ύψος του εξαρτάται από τη γραμματοσειρά.
\newcommand{\CheckSquare}{\tikz[baseline=-0.5ex]\draw[BookPrimary,line width=.55pt] (0,0) rectangle (\BookCheckSquareSize,\BookCheckSquareSize);}
% ΔΙΣΤΗΛΗ ΔΙΑΤΑΞΗ: \begin{multicols}{2} ... \end{multicols}.
% Προσοχή: σε στενή στήλη οι μακριές εξισώσεις μπορεί να απαιτούν μία στήλη.
% Σε δίστηλες Σ/Λ χρησιμοποίησε \TrueFalseItem{...}, όχι χειροκίνητα □.
% generic two-column text block: use \begin{multicols}{2} and \end{multicols}
% --------------------------------------------------------------------------
% ΛΥΣΕΙΣ ΑΛΥΤΩΝ ΑΣΚΗΣΕΩΝ: με ίδιο μπλε νούμερο και διαχωριστικό.
% Η λύση αναζητεί τον εσωτερικό κωδικό της αρχικής άσκησης.
% Παράδειγμα: \begin{booksolution}{PHY-A-001} ... \end{booksolution}
% \ref{ex:PHY-A-001} εμφανίζει τον αυτόματο αριθμό της άσκησης.
% Αν αλλάξει η σειρά ασκήσεων, η παραπομπή ενημερώνεται στη 2η compile.
% Δεν επαναλαμβάνουμε την εκφώνηση ούτε προσθέτουμε το ThinkBox.
% --------------------------------------------------------------------------
\NewDocumentEnvironment{booksolution}{m}{%
 \Needspace{4\baselineskip}\par\addvspace{6pt}\noindent\leavevmode
 \mbox{{\fontsize{\BookExerciseNumberSize}{14}\selectfont\bfseries\color{BookPrimary}\ref{ex:#1}}%
  \hspace{2.3mm}{\color{BookSecondary}\rule{\BookExerciseSeparatorWidth}{\BookExerciseSeparatorHeight}}}%
 \nobreak\hspace{2.6mm}\ignorespaces
}{\par\addvspace{4pt}}
% ===========================================================================
% ΚΡΙΤΗΡΙΑ ΑΞΙΟΛΟΓΗΣΗΣ (v0.15) — ΜΙΑ ΜΑΚΕΤΑ ΓΙΑ ΒΙΒΛΙΟ ΚΑΙ ΔΙΑΓΩΝΙΣΜΑ
% ===========================================================================
% Κεντρικές επιλογές από τον συγγραφέα:
%   \begin{Assessment}{Ευθύγραμμη κίνηση} ... \end{Assessment}
%   \begin{Assessment}[student=true,date=true,duration={90 λεπτά}]{Τίτλος}
%   \begin{Assessment}[date={18/10/2026}]{Τίτλος}
% Το student=true δημιουργεί πεδίο ονοματεπωνύμου· προεπιλογή false.
% Το date=true δημιουργεί κενό πεδίο ημερομηνίας· date={...} συγκεκριμένη.
% Το duration είναι ελεύθερο κείμενο· προεπιλογή κενό (καμία διάρκεια).
% Η ενότητα δεν δημιουργεί άσκοπο χώρο για απενεργοποιημένα πεδία.
%
%   \AssessmentTopic{Α}      -> ΘΕΜΑ Α, μηδενίζει τον μετρητή ερωτήσεων
%   \begin{AssessmentQuestion}[5] Κείμενο... \end{AssessmentQuestion}
%   \begin{AssessmentQuestion}    Κείμενο... \end{AssessmentQuestion}
% Τα ερωτήματα αριθμούνται αυτόματα Α1., Α2., Β1. κ.ο.κ.
% Οι μονάδες γράφονται δεξιά και είναι ΠΡΟΑΙΡΕΤΙΚΕΣ.
% Το περιεχόμενο του ερωτήματος μπορεί να έχει μαθηματικά, λίστες και TikZ.
% Προαιρετική επαλήθευση αθροίσματος: \AssessmentPointsCheck[100]
% Εμφανίζει προειδοποίηση στο LOG αν το άθροισμα είναι διαφορετικό.
% Η εμφάνιση χρησιμοποιεί μόνο BookPrimary, BookSoft και BookInk,
% άρα λειτουργεί και στο SCREEN και στο ελεγχόμενο δίχρωμο PRINT.
% ===========================================================================
\newcounter{assessment}
\newcounter{assessmenttopic}[assessment]
\newcounter{assessmentquestion}
\newcounter{assessmenttotal}
% Η ορατή αρίθμηση επανεκκινεί ανά ΘΕΜΑ· ο σύνδεσμος πρέπει να είναι μοναδικός.
\renewcommand{\theHassessmentquestion}{\arabic{assessment}.\arabic{assessmenttopic}.\arabic{assessmentquestion}}
\newcommand{\BookAssessmentTopicLetter}{Α}
\renewcommand{\theassessmentquestion}{\BookAssessmentTopicLetter\arabic{assessmentquestion}}

% Αποθήκευση προαιρετικών παραμέτρων με pgfkeys (ήδη υπάρχει λόγω TikZ).
\pgfkeys{/bookassessment/.is family,/bookassessment,
 student/.store in=\BookAssessmentStudentSetting,
 date/.store in=\BookAssessmentDateSetting,
 duration/.store in=\BookAssessmentDurationSetting}

% Οι εξεταστικές σελίδες έχουν δική τους κεφαλίδα, όχι «Ενότητα Ν».
% Το πουλί εξακολουθεί να καθρεφτίζεται στις αριστερές σελίδες.
\fancypagestyle{bookassessment}{%
  \fancyhf{}%
  % ΙΔΙΕΣ ρυθμίσεις τίτλου, χρωμάτων, πουλιού και γραμμής με το fancy.
  % Το Κείμενο της κεφαλίδας αλλάζει ανεξάρτητα από τη μπλε λωρίδα.
  \BookApplyRunningHeaders{\BookAssessmentHeaderLabel\space\theassessment}%
  \BookApplyFooter%
  \BookApplyPageRules%
}

% Προαιρετική εμφάνιση κενής ή συγκεκριμένης ημερομηνίας.
\newcommand{\BookAssessmentDateLine}{%
 \ifdefstring{\BookAssessmentDateSetting}{false}{}{%
   \ifdefstring{\BookAssessmentDateSetting}{true}{Ημερομηνία: \rule{26mm}{.35pt}}{Ημερομηνία: \BookAssessmentDateSetting}%
 }%
}

% Ενιαίο περιβάλλον. Προκαλεί νέα σελίδα, όχι επιπλέον «δεξιά» λευκή.
% Τα επιμέρους πεδία έχουν ακριβώς μηδενικό ύψος όταν λείπουν.
\NewDocumentEnvironment{Assessment}{O{} m}{%
 \clearpage
 \pgfkeys{/bookassessment/.cd,student=false,date=false,duration={},#1}%
 \refstepcounter{assessment}\setcounter{assessmentquestion}{0}\setcounter{assessmenttotal}{0}%
 % Καταχώριση στο TOC με τίτλο και σωστή σελίδα, χωρίς χειροκίνητες γραμμές.
 \BookTOCOpenCollection{assessment}{Κριτήρια Αξιολόγησης}%
 \phantomsection\addcontentsline{toc}{subsection}{Κριτήριο αξιολόγησης\space\theassessment\space—\space #2}%
 \gdef\BookAssessmentTopicLetter{Α}%
 \markboth{#2}{#2}\pagestyle{bookassessment}\thispagestyle{bookassessment}%
 \par\noindent
 \begin{tcolorbox}[enhanced,sharp corners,frame hidden,boxrule=0pt,
     colback=BookPrimary,left=4mm,right=4mm,top=3mm,bottom=3mm,
     before skip=0pt,after skip=7pt]
   {\sffamily\fontsize{8.6}{11}\selectfont\color{white}\LabelAssessment\space\theassessment}\par\vspace{1.4mm}%
   {\BookHeadingFont\fontsize{16}{20}\selectfont\color{white}#2}%
 \end{tcolorbox}%
 \ifdefstring{\BookAssessmentStudentSetting}{true}{%
   \par\noindent{\small\color{BookInk}Ονοματεπώνυμο: \rule{\dimexpr\linewidth-39mm\relax}{.35pt}}\par\vspace{3pt}%
 }{}%
 \ifdefstring{\BookAssessmentDateSetting}{false}{%
   \ifdefempty{\BookAssessmentDurationSetting}{}{\par\noindent{\small\color{BookInk}Διάρκεια: \BookAssessmentDurationSetting}\par\vspace{3pt}}%
 }{%
   \par\noindent{\small\color{BookInk}\BookAssessmentDateLine\hfill
     \ifdefempty{\BookAssessmentDurationSetting}{}{Διάρκεια: \BookAssessmentDurationSetting}}\par\vspace{3pt}%
 }%
 \par\vspace{5pt}%
}{%
 \par\clearpage\pagestyle{fancy}%
}

% Δομή ΘΕΜΑ Α, ΘΕΜΑ Β, ΘΕΜΑ Γ ή ΘΕΜΑ Δ.
% Μπορείς να δώσεις όσα θέματα χρειάζεσαι, όχι αναγκαστικά τέσσερα.
\NewDocumentCommand{\AssessmentTopic}{m}{%
 \par\Needspace{5\baselineskip}\addvspace{10pt}%
 \stepcounter{assessmenttopic}%
 \gdef\BookAssessmentTopicLetter{#1}%
 \setcounter{assessmentquestion}{0}%
 \noindent\begin{tcolorbox}[enhanced,sharp corners,frame hidden,boxrule=0pt,
   colback=BookSoft,left=3mm,right=3mm,top=1.7mm,bottom=1.7mm,
   before skip=0pt,after skip=7pt]
  {\sffamily\bfseries\fontsize{10.4}{13}\selectfont\color{BookPrimary}\LabelAssessmentTopic\space #1}%
 \end{tcolorbox}%
}

% Ερώτημα Α1./Β2./Γ3. με προαιρετικές μονάδες δεξιά σε νέα γραμμή.
% Προϋπόθεση για το αυτόματο άθροισμα: οι μονάδες είναι ακέραιος αριθμός.
% Η \Needspace κρατά μαζί τον αριθμό και την αρχή της εκφώνησης.
\NewDocumentEnvironment{AssessmentQuestion}{o}{%
 \par\Needspace{3\baselineskip}\addvspace{7pt}%
 \refstepcounter{assessmentquestion}%
 \IfNoValueF{#1}{\addtocounter{assessmenttotal}{#1}}%
 \noindent\leavevmode
 {\sffamily\bfseries\color{BookPrimary}\theassessmentquestion.}\nobreak\hspace{2.5mm}%
 \ignorespaces
}{%
 \par\IfNoValueF{#1}{%
    \nobreak\vspace{2pt}{\raggedleft\sffamily\fontsize{8.7}{11.5}\selectfont
       \color{BookInk}(\LabelAssessmentPoints\space #1)\par}%
 }%
 \addvspace{6pt}%
}

% Προαιρετικός έλεγχος 100 ή άλλου συνόλου, χωρίς εμφάνιση στο PDF.
\NewDocumentCommand{\AssessmentPointsCheck}{O{100}}{%
 \ifnum\value{assessmenttotal}=#1\relax
   \typeout{ASSESSMENT POINTS OK: \arabic{assessmenttotal}/#1}%
 \else
   \PackageWarning{universalbook}{Assessment points: \arabic{assessmenttotal}; expected #1}%
 \fi
}
