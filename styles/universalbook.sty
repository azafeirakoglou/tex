\newcommand{\BookCalloutOpenBook}{%
  \begin{tikzpicture}[x=1mm,y=1mm,scale={\BookCalloutIconScale*\BookOpenBookScale},
    yscale=\BookOpenBookHeightScale,
    line cap=round,line join=round]
    % Εξώφυλλο κάτω από τα δύο ανοιχτά φύλλα.
    \draw[draw=BookHistory,line width=\BookOpenBookOutlineWidth]
      (-4.9,2.1)--(-4.9,-2.2)
      .. controls (-3,-1.9) and (-1.2,-2.2) .. (0,-3.15)
      .. controls (1.2,-2.2) and (3,-1.9) .. (4.9,-2.2)--(4.9,2.1);
    % Ανοικτό βιβλίο: χαμηλά το κέντρο, ψηλά οι έξω άκρες.
    \draw[draw=BookHistory,line width=\BookOpenBookOutlineWidth]
      (0,-2.65)
      .. controls (-1.1,-1.7) and (-2.8,-1.3) .. (-4.5,-1.7)
      --(-4.5,2.6)
      .. controls (-2.8,2.95) and (-1.1,2.2) .. (0,1.2)
      .. controls (1.1,2.2) and (2.8,2.95) .. (4.5,2.6)
      --(4.5,-1.7)
      .. controls (2.8,-1.3) and (1.1,-1.7) .. cycle;
    \draw[draw=BookHistory,line width=\BookOpenBookOutlineWidth] (0,1.2)--(0,-2.65);
    % Τρεις καμπύλες αράδες σε κάθε σελίδα, με ανοικτή κεντρική ζώνη.
    \foreach \y in {0,-.95,-1.9}{%
