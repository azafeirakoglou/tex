% ΠΡΟΑΙΡΕΤΙΚΕΣ ΛΥΣΕΙΣ ΚΡΙΤΗΡΙΩΝ — χωρίς νέο κουτί, όπως οι άλυτες.
% Μέσα σε ένα AssessmentQuestion γράψε \label{asq:KRI1-A1} μετά την έναρξη.
% Στις συγκεντρωτικές λύσεις γράψε:
%   \begin{AssessmentSolution}{asq:KRI1-A1}
%      Το σωστό είναι το (γ), επειδή ...
%   \end{AssessmentSolution}
% Η \ref επιστρέφει Α1, Β2 κ.λπ. ακόμη και αν αλλάξει η αρίθμηση.
% ---------------------------------------------------------------------------
\NewDocumentEnvironment{AssessmentSolution}{m}{%
 \Needspace{3\baselineskip}\par\addvspace{7pt}\noindent\leavevmode
 \mbox{{\sffamily\bfseries\color{BookPrimary}\ref{#1}}%
   \hspace{2.3mm}{\color{BookSecondary}\rule{\BookExerciseSeparatorWidth}{\BookExerciseSeparatorHeight}}}%
 \nobreak\hspace{2.6mm}\ignorespaces
}{\par\addvspace{5pt}}

\endinput
